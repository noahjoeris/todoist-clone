# Copy to .env. Client: apps/client/.env. Self-hosted Supabase: infra/supabase/.env

# --- always ---
PORT=3000                          # Fastify listen port
LOG_LEVEL=info
CORS_ORIGIN=                       # comma-separated origins, or *

# --- managed or self-hosted (same keys, don't mix) ---
DATABASE_URL=                      # API postgres (cloud pooler :6543 / local :5432)
DATABASE_MIGRATION_URL=            # drizzle (cloud direct :5432 / local: same as DATABASE_URL)
SUPABASE_URL=                      # cloud: https://<ref>.supabase.co / local: http://localhost:8000
SUPABASE_SECRET_KEY=               # service-role; never ship to the client
POWERSYNC_REPLICATION_PASSWORD=    # invent; Postgres user powersync_role

# --- self-hosted only ---
API_HOST_PORT=3000                 # docker host port → API container 3000
API_DATABASE_URL=                  # API container postgres (compose hostname)
API_SUPABASE_URL=                  # API container supabase (compose hostname)
POWERSYNC_STORAGE_PASSWORD=        # invent; PowerSync bucket-storage Postgres
POWERSYNC_PORT=8080                # docker host port → PowerSync container 8080
