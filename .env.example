# Copy to .env at the repo root. Read by: Fastify (pnpm dev:api), drizzle-kit (pnpm db:*),
# and docker compose (compose.yaml, compose.local.yaml).
# The Expo client has its own file: apps/client/.env (see apps/client/.env.example).
# The self-hosted Supabase stack has its own file: infra/supabase/.env.

############
# API (Fastify)
############
PORT=3000
LOG_LEVEL=info
# Comma-separated origins, or *. Web client (expo start --web) talks from the Expo origin.
# The parser is exact strings or the single value *; https://*.pages.dev is not a wildcard.
# CORS_ORIGIN=http://localhost:8081
# After the web preview is live, include that origin on the deployed API, e.g.
# CORS_ORIGIN=https://todoist-clone.pages.dev,http://localhost:8081
CORS_ORIGIN=*

############
# Postgres (application database)
############
# Runtime connection for the API. Supabase Cloud: use the Supavisor *transaction* pooler URL.
# Local stack: postgresql://postgres:<POSTGRES_PASSWORD from infra/supabase/.env>@localhost:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# Migrations need a direct (session) connection. Supabase Cloud: the "Direct connection" string.
# Local stack: same value as DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

############
# Supabase (server-side)
############
# Cloud: https://<project-ref>.supabase.co   Local stack: http://localhost:8000
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret (service role) key. Never expose to clients.
SUPABASE_SECRET_KEY=sb_secret_xxx

############
# Docker compose: API container (compose.yaml)
############
# Optional overrides so the API container can reach services by compose hostname
# instead of localhost. Leave unset when using cloud services.
# API_DATABASE_URL=postgresql://postgres:password@db:5432/postgres
# API_SUPABASE_URL=http://kong:8000
API_PORT=3000

############
# Docker compose: self-hosted PowerSync (compose.local.yaml)
############
# Password of the `powersync_role` replication user in the application database
# (created by `pnpm infra:powersync:bootstrap`).
POWERSYNC_REPLICATION_PASSWORD=change-me-replication
# Password of the dedicated PowerSync bucket-storage Postgres.
POWERSYNC_STORAGE_PASSWORD=change-me-storage
POWERSYNC_PORT=8080
