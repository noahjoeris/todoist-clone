{
  "name": "@todoist-clone/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API: validates and authorizes PowerSync uploads and other server-side operations.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@todoist-clone/contracts": "workspace:*",
    "@todoist-clone/database": "workspace:*",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
