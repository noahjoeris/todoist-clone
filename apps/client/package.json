{
  "name": "@todoist-clone/client",
  "version": "0.0.0",
  "private": true,
  "description": "Expo app (iOS, Android, web) reading and writing a local PowerSync SQLite database.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "pnpm powersync:copy-assets && expo start --web",
    "export:web": "pnpm powersync:copy-assets && expo export --platform web",
    "prebuild": "expo prebuild",
    "powersync:copy-assets": "powersync-web copy-assets --output public",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "echo 'no integration tests'"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@expo/metro-runtime": "~57.0.15",
    "@op-engineering/op-sqlite": "^18.2.1",
    "@powersync/common": "^2.2.0",
    "@powersync/react": "^2.0.1",
    "@powersync/react-native": "^2.2.0",
    "@powersync/web": "^2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "@todoist-clone/contracts": "workspace:*",
    "expo": "~57.0.21",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-async-generator-functions": "^7.29.7",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
