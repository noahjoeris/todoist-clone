# Copy to apps/client/.env. All four set, or all four empty (guest-only).

EXPO_PUBLIC_SUPABASE_URL=              # cloud project URL / local: http://localhost:8000
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # public key (cloud dashboard / infra/supabase/.env)
EXPO_PUBLIC_POWERSYNC_URL=             # cloud instance URL / local: http://localhost:8080
EXPO_PUBLIC_API_URL=                   # Fastify origin, e.g. http://localhost:3000
