# Public client configuration. Everything in this file is bundled into the app.
# Copy to apps/client/.env (Expo reads env files from the app directory, not the repo root).

# Supabase project (Cloud: Project Settings -> API; local stack: http://localhost:8000 + SUPABASE_PUBLISHABLE_KEY)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# PowerSync instance (Cloud: dashboard -> Connect; local stack: http://localhost:8080)
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# Fastify API
EXPO_PUBLIC_API_URL=http://localhost:3000
