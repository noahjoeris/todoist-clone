# Public client configuration. Everything in this file is bundled into the app.
# Copy to apps/client/.env (Expo reads env files from the app directory, not the repo root).

# Cloud configuration is all-or-nothing: set all four, or leave all four unset for guest-only.
# Setting any without the others is reported as a configuration error in the app.

# Supabase project, used for authentication.
# Cloud: Project Settings -> API. Local stack: http://localhost:8000 + infra/supabase SUPABASE_PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# PowerSync instance (Cloud: dashboard -> Connect; local stack: http://localhost:8080)
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
# Fastify API (PowerSync uploads). Web: allow this Expo origin in the API CORS_ORIGIN.
EXPO_PUBLIC_API_URL=http://localhost:3000
